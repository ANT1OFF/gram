{
  "name": "gram",
  "version": "1.21.0",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@effect/sql-sqlite-node": "4.0.6",
      "@effect/vitest": "4.0.6",
      "ai": "7.0.165",
      "@modelcontextprotocol/sdk": "1.32.2",
      "node-pty": "1.1.0",
      "sherpa-onnx-node": "2.0.0",
      "ghostty-web": "0.4.0",
      "@types/node": "26.6.6",
      "oxlint": "1.92.0",
      "oxlint-tsgolint": "7.0.2006",
      "typescript": "7.0.2",
      "vitest": "5.1.0",
      "@babel/core": "8.1.0",
      "@base-ui/react": "1.9.0",
      "@fontsource-variable/geist": "5.3.0",
      "@fontsource-variable/geist-mono": "5.3.0",
      "@rolldown/plugin-babel": "0.3.0",
      "@tailwindcss/vite": "4.3.5",
      "@tanstack/react-query": "5.107.1",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/router-plugin": "1.169.0",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.2.1",
      "babel-plugin-react-compiler": "1.0.0",
      "class-variance-authority": "0.7.1",
      "cn": "0.5.2",
      "lucide-react": "1.70.0",
      "motion": "14.10.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "shadcn": "4.23.0",
      "tailwindcss": "4.3.5",
      "tw-animate-css": "1.4.0",
      "vite": "8.3.6",
      "zustand": "5.1.0",
      "electron": "45.2.3",
      "electron-builder": "26.18.1",
      "electron-updater": "6.8.12",
      "electron-vite": "6.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "node tools/sherpa-onnx/install.mjs",
    "dev": "bun run --filter @gram/web dev",
    "dev:desktop": "bun run --filter @gram/desktop dev",
    "build": "bun run typecheck && bun run build:bundles",
    "build:bundles": "bun run --filter @gram/web build && bun run --filter @gram/desktop build",
    "check": "node tools/check/run.mjs",
    "check:affected": "node tools/check/run.mjs --affected",
    "check:cancel": "node tools/check/run.mjs --cancel",
    "check:static": "bun run lint && bun run fmt:check && bun run typecheck",
    "check:ci": "bun run check && bun run build:bundles",
    "lint": "node tools/check-dependency-pins.mjs && node tools/design-tokens/check.mjs && oxlint --deny-warnings",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=3",
    "test:loop": "node tools/check/test-loop.mjs",
    "check:scaffold": "node tools/check-public-scaffold.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "host-protocol:release": "GRAM_HOST_RELEASED=write vitest run packages/contracts/src/rpc/host-compat.test.ts",
    "packages:pack": "node tools/packages/pack.mjs",
    "packages:verify": "node tools/packages/verify.mjs",
    "release:rc": "node tools/release-rc/rc.mjs",
    "release:stable": "node tools/release-stable/stable.mjs",
    "mocks:tokens": "node .agents/skills/mock-build/scripts/mock-tokens.mjs docs/design/mocks/tokens.config.json",
    "dev:mock": "VITE_API=mock bun run --filter @gram/web dev:web",
    "dev:preview": "node apps/web/scripts/isolated-preview.mjs",
    "e2e:real": "bun run --filter @gram/web e2e:real",
    "e2e:smoke": "bun run --filter @gram/web e2e subscription-agents.spec.ts launch-checks.spec.ts gateways.spec.ts new-thread-folder.spec.ts --workers=1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "node-gyp": "13.1.0",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "sherpa-onnx-darwin-arm64": "2.0.0",
    "sherpa-onnx-darwin-x64": "2.0.0",
    "sherpa-onnx-linux-arm64": "2.0.0",
    "sherpa-onnx-linux-x64": "2.0.0",
    "sherpa-onnx-win-arm64": "2.0.0",
    "sherpa-onnx-win-ia32": "2.0.0",
    "sherpa-onnx-win-x64": "2.0.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@effect/platform-node-shared@4.0.6": "patches/@effect__platform-node-shared@4.0.6.patch"
  },
  "trustedDependencies": [
    "electron",
    "node-pty"
  ]
}
