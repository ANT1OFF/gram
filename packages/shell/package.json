      "default": "./src/modules/agent-browser/main.ts"
    },
    "./modules/connection": {
      "types": "./src/modules/connection/main.ts",
      "default": "./src/modules/connection/main.ts"
    },
    "./modules/fonts": {
      "types": "./src/modules/fonts/main.ts",
      "default": "./src/modules/fonts/main.ts"
    },
    "./modules/ipc": {
      "types": "./src/modules/ipc.ts",
      "default": "./src/modules/ipc.ts"
    },
    "./modules/key-vault": {
      "types": "./src/modules/key-vault/index.ts",
      "default": "./src/modules/key-vault/index.ts"
