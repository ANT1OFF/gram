{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "versioning": "prerelease",
      "prerelease": false,
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "skip-github-release": true,
      "draft-pull-request": true,
      "extra-files": [
        { "type": "json", "path": "apps/desktop/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "bun.lock" }
      ],
      "pull-request-header": "Desktop release metadata proposal only. Merging this PR does not publish or tag Gram; follow docs/RELEASING.md to release."
    }
  }
}
