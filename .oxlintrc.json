{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
  "jsPlugins": ["./tools/oxlint/gram.mjs", "./tools/oxlint/anti-slop/index.ts"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": [
      "warn",
      { "additionalHooks": "^(useSubscription|useExternalSync|useLayoutSync)$" }
    ],
    "react/set-state-in-effect": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-imports": "error",
    // `import { type A } from "x"` keeps "x" as a side-effect import: write `import type`.
    "typescript/no-import-type-side-effects": "error",
    // A switch over a union names every member, so a new one fails here until it is handled.
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "allowDefaultCaseForExhaustiveSwitch": true, "considerDefaultExhaustiveForUnions": true }
    ],
    "typescript/no-explicit-any": "error",
    "no-unused-vars": [
      "error",
      { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ],
    "no-underscore-dangle": ["warn", { "allow": ["_tag", "__flicker", "__gutters"] }],
    "gram/disable-reason": "error",
    "gram/no-bare-fork": "error",
    "gram/no-focused-tests": "error",
    "gram/no-sleep": "error",
    "gram/no-raw-effect": "error",
    "gram/max-lines": "error",
    "gram/no-cross-package-path": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-widen-then-assert": "error",
    // A test replaces a dependency through a real seam, not by swapping the module it imports.
    // Where the dependency is the platform itself (Electron, a native addon, a failure Node
    // must be made to give), the file says so on its disable.
    "anti-slop/no-module-mocking": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "package": "node:test", "name": ["describe", "it", "suite", "test"] }
        ]
      }
    ],
    // An async JSX handler is React's own idiom; the handlers catch their own failures.
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
    "typescript/use-unknown-in-catch-callback-variable": "error",
    // Type-aware rules (`--type-aware`, run by tsrs) that the categories above turn on, measured
    // and left off: none found a bug in Gram's code. no-misused-spread flags `[...text]`, which
    // Gram uses on purpose to split by code point, and Schema.Opaque values it takes for classes;
    // no-base-to-string flags `String(x ?? "")` over parsed protocol fields; the "unnecessary"
    // and "type constituent" ones only flag dead but harmless code; no-implied-eval only fires in
    // tests that run the theme's boot script. require-array-sort-compare and
    // restrict-template-expressions are on for product code, below.
    "typescript/no-base-to-string": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-implied-eval": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-unnecessary-template-expression": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    // A function that ends in an exhaustive `switch` needs no trailing return; its declared
    // return type already makes the compiler check every path.
    "typescript/consistent-return": "off",
    // Gram's stores, bridges and services are closures typed with method signatures, so passing
    // `connection.get` or destructuring `getState()` never drops a `this` they would read.
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      "files": [
        "packages/agents/src/**",
        "packages/contracts/src/**",
        "packages/git/src/**",
        "packages/server/src/**",
        "packages/shell/src/**",
        "packages/themes/src/**",
        "apps/desktop/src/**",
        "apps/web/src/**"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "error"
      }
    },
    {
      "files": ["packages/*/src/**", "apps/*/src/**"],
      "rules": {
        "gram/no-raw-git": "error",
        "gram/no-comment": "error",
        // A default sort compares as text, so [9, 10] sorts as [10, 9]: give the comparison.
        "typescript/require-array-sort-compare": "error",
        // `${value}` of an object reads "[object Object]": narrow it, or say how it reads.
        "typescript/restrict-template-expressions": ["error", { "allowNever": true }]
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        // Mid-migration: the web app's router mocks move to a real router in the changes that
        // follow.
        "anti-slop/no-module-mocking": "off"
      }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        // The web app's mock backend stands in for the server, so a value of a contract's tagged
        // type there is built with its own class or schema (`new NotFound(…)`, `.make`) and can't
        // drift from it. Elsewhere the literal `_tag`s left are local unions with no constructor
        // to call, so the rule stops at the web app.
        "anti-slop/no-manual-tagged-construction": "error"
      }
    },
    {
      "files": ["packages/server/src/**", "packages/git/src/**"],
      "rules": {
        "gram/no-raw-path": "error",
        "gram/remote-git-only": "error",
        "gram/no-day-math": "error",
        "gram/no-adhoc-lock": "error"
      }
    },
    {
      "files": ["apps/web/src/**", "apps/web/e2e-embed/**"],
      "rules": {
        "gram/lucide-stroke": "error",
        "gram/link-not-button": "error"
      }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "gram/clock-24h": "error",
        "gram/no-timer": "error",
        "gram/settings-entry": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The web app is the renderer and runs in a plain browser too. Reach the desktop through the window.gram bridge, whose shape is in @gram/contracts, never Electron itself."
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "This code runs in the browser renderer, where Node has no modules. Ask the server over the API, or the desktop through the window.gram bridge."
              },
              {
                "group": [
                  "@gram/agents",
                  "@gram/git",
                  "@gram/server",
                  "@gram/shell",
                  "@gram/agents/**",
                  "@gram/git/**",
                  "@gram/server/**",
                  "@gram/shell/**"
                ],
                "message": "The web app runs in the browser and only talks to the server and the shell over their contracts. Its package.json names what it may depend on (see docs/ARCHITECTURE.md): @gram/contracts, @gram/themes. Move the shared piece down into one of those (shapes go in @gram/contracts), or put this code in the package that already owns the dependency."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/contracts/src/**", "packages/themes/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Contracts and themes are shared by the browser, the server and Electron alike, so they import no runtime. Keep runtime code in the package that runs it."
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "Contracts and themes are loaded in the browser too, where Node has no modules. Keep this here as a pure shape or value, and do the Node work in @gram/server or @gram/git."
              },
              {
                "group": [
                  "@gram/agents",
                  "@gram/contracts",
                  "@gram/git",
                  "@gram/server",
                  "@gram/shell",
                  "@gram/themes",
                  "@gram/agents/**",
                  "@gram/contracts/**",
                  "@gram/git/**",
                  "@gram/server/**",
                  "@gram/shell/**",
                  "@gram/themes/**"
                ],
                "message": "Contracts and themes are the bottom of the graph and import nothing in the workspace. Its package.json names what it may depend on (see docs/ARCHITECTURE.md): nothing in the workspace. Move the shared piece down into one of those (shapes go in @gram/contracts), or put this code in the package that already owns the dependency."
              },
              {
                "group": ["@gram/web", "@gram/web/**", "@gram/desktop", "@gram/desktop/**"],
                "message": "A package never imports an app: apps depend on packages, not the other way round. Move what both need into the package (or into @gram/contracts if it is a shared shape)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/agents/src/**", "packages/git/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "allowTypeImports": true,
                "message": "Native Electron is main-process only: keep it in @gram/shell (core, electron, modules) or apps/desktop/src/main. Here, take what you need as a parameter or through a shell module, so this code stays usable outside Electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@gram/agents",
                  "@gram/git",
                  "@gram/server",
                  "@gram/shell",
                  "@gram/themes",
                  "@gram/agents/**",
                  "@gram/git/**",
                  "@gram/server/**",
                  "@gram/shell/**",
                  "@gram/themes/**"
                ],
                "message": "This package sits just above contracts. Its package.json names what it may depend on (see docs/ARCHITECTURE.md): @gram/contracts. Move the shared piece down into one of those (shapes go in @gram/contracts), or put this code in the package that already owns the dependency."
              },
              {
                "group": ["@gram/web", "@gram/web/**", "@gram/desktop", "@gram/desktop/**"],
                "message": "A package never imports an app: apps depend on packages, not the other way round. Move what both need into the package (or into @gram/contracts if it is a shared shape)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/server/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "allowTypeImports": true,
                "message": "Native Electron is main-process only: keep it in @gram/shell (core, electron, modules) or apps/desktop/src/main. Here, take what you need as a parameter or through a shell module, so this code stays usable outside Electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@gram/server",
                  "@gram/shell",
                  "@gram/themes",
                  "@gram/server/**",
                  "@gram/shell/**",
                  "@gram/themes/**"
                ],
                "message": "The server runs as its own Node process, with or without the desktop. Its package.json names what it may depend on (see docs/ARCHITECTURE.md): @gram/agents, @gram/contracts, @gram/git. Move the shared piece down into one of those (shapes go in @gram/contracts), or put this code in the package that already owns the dependency."
              },
              {
                "group": ["@gram/web", "@gram/web/**", "@gram/desktop", "@gram/desktop/**"],
                "message": "A package never imports an app: apps depend on packages, not the other way round. Move what both need into the package (or into @gram/contracts if it is a shared shape)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/shell/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@gram/agents",
                  "@gram/server",
                  "@gram/shell",
                  "@gram/themes",
                  "@gram/agents/**",
                  "@gram/server/**",
                  "@gram/shell/**",
                  "@gram/themes/**"
                ],
                "message": "The shell is the Electron layer and reaches the server over its API, not its source. Its package.json names what it may depend on (see docs/ARCHITECTURE.md): @gram/contracts, @gram/git. Move the shared piece down into one of those (shapes go in @gram/contracts), or put this code in the package that already owns the dependency."
              },
              {
                "group": ["@gram/web", "@gram/web/**", "@gram/desktop", "@gram/desktop/**"],
                "message": "A package never imports an app: apps depend on packages, not the other way round. Move what both need into the package (or into @gram/contracts if it is a shared shape)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/preload/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "!electron",
                  "!@gram/shell/channels",
                  "!@gram/shell/preload",
                  "!@gram/shell/window-arg",
                  "!./*"
                ],
                "allowTypeImports": true,
                "message": "A sandboxed preload can load nothing but `electron`, so this bundle may bring in values only from `electron` and the shell's preload-safe entries: @gram/shell/channels, @gram/shell/preload and @gram/shell/window-arg (packages/shell/src/entries.test.ts holds them to it). Import types with `import type`; anything that reads files, runs a command or needs Node goes in apps/desktop/src/main behind a channel, and the preload asks for it with ipcRenderer.invoke."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/main/**", "apps/desktop/src/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@gram/web", "@gram/web/**"],
                "message": "The desktop's main process loads the web app as a page, it never imports it. Shapes both sides use go in @gram/contracts; the page reaches main through the window.gram bridge."
              },
              {
                "group": ["@gram/agents", "@gram/agents/**", "@gram/server/main"],
                "message": "The server runs in its own process, which main starts (main/server-host.ts) and talks to over the API, so agent and server code never load into the Electron main process. From @gram/server, main may import only its light entries: @gram/server/logging, @gram/server/updates and @gram/server/host/launch-args. Ask the server over its API, or add a light export to packages/server/package.json for a pure helper."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/**", "apps/*/src/**"],
      "rules": {
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error"
      }
    },
    {
      "files": ["**/*.js", "**/*.mjs", "**/*.cjs"],
      "rules": {
        // Plain JavaScript has no annotation to give a catch callback's parameter `unknown`, and
        // nothing to type what it parses, so the unsafe-`any` rules only flag the language.
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/use-unknown-in-catch-callback-variable": "off"
      }
    },
    {
      "files": [
        "**/testing.ts",
        "**/testing/**",
        "**/*.testing.ts",
        "**/test-utils.ts",
        "**/test-utils.tsx",
        "**/test-harness.ts",
        "**/test-kit.ts",
        "**/*-service-kit.ts",
        "**/*-fixture.ts",
        "**/*-test-fixtures.ts",
        "**/*-fixtures.ts",
        "**/*-harness.ts",
        "**/*-fake.ts",
        "apps/web/src/api/mock.ts",
        "apps/web/src/api/mock-*.ts",
        "apps/web/src/api/mock-*/**"
      ],
      "rules": {
        // Fixture loaders, fakes and the web app's mock backend build or read recordings as the
        // types they stand for.
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mts", "**/*.test.mjs", "**/test/**"],
      "rules": {
        "no-restricted-imports": "off",
        // A test's fixtures and fakes cast freely; product code parses at its boundaries.
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        // A test's expectations name tags as plain objects (`toMatchObject({ _tag: "Done" })`).
        "anti-slop/no-manual-tagged-construction": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/restrict-template-expressions": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/out/**",
    "**/release/**",
    "**/routeTree.gen.ts",
    "packages/agents/src/codex/protocol/**"
  ]
}
